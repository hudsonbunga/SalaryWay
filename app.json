{
  "expo": {
    "name": "SalaryWay",
    "slug": "salaryway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "salaryway",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salaryway.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16A36A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.salaryway.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-splash-screen",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SalaryWay to access your camera to scan UPI payment QR codes."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "812e28c8-a231-4422-8123-27ac717ef2af"
      }
    },
    "owner": "hudsonbunga"
  }
}
